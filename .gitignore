# ==============================================================================
# Monorepo Master .gitignore (Backend, Frontend, Mobil)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operating System & Editor Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.swp
*.swo
*~
*.lock

# IDEs
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.vscode/
**/.vscode/
.history/
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 2. Backend (Java / Spring Boot / Maven)
# ------------------------------------------------------------------------------
backend/target/
**/target/
*.class
*.war
*.ear
backend/.mvn/wrapper/maven-wrapper.jar
backend/.apt_generated
backend/.factorypath
backend/.springBeans
backend/.sts4-cache
HELP.md

# ------------------------------------------------------------------------------
# 3. Frontend (Angular / Node.js)
# ------------------------------------------------------------------------------
frontend/node_modules/
**/node_modules/
frontend/dist/
frontend/.angular/
frontend/out-tsc/
frontend/bazel-out/
frontend/coverage/
frontend/.sass-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.prettier-cache/

# ------------------------------------------------------------------------------
# 4. Mobile (Flutter / Dart / Android / iOS)
# ------------------------------------------------------------------------------
# Flutter / Dart
mobile/.dart_tool/
mobil/.dart_tool/
mobile/.flutter-plugins*
mobil/.flutter-plugins*
mobile/.pub/
mobil/.pub/
mobile/.pub-cache/
mobil/.pub-cache/
mobile/build/
mobil/build/
**/build/
mobile/coverage/
mobil/coverage/
mobile/.metadata
mobil/.metadata

# Android Specific
mobile/android/.gradle/
mobil/android/.gradle/
mobile/android/local.properties
mobil/android/local.properties
mobile/android/gradle-wrapper.jar
mobil/android/gradle-wrapper.jar
mobile/android/captures/
mobil/android/captures/
mobile/android/.cxx/
mobil/android/.cxx/
mobile/android/GeneratedPluginRegistrant.java
mobil/android/GeneratedPluginRegistrant.java
mobile/android/app/debug/
mobil/android/app/profile/
mobil/android/app/release/
*.keystore
*.jks
key.properties

# iOS Specific
mobile/ios/.symlinks/
mobil/ios/.symlinks/
mobile/ios/Pods/
mobil/ios/Pods/
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/flutter_export_environment.sh
mobile/ios/Flutter/ephemeral/
mobil/ios/Flutter/Generated.xcconfig
mobil/ios/Flutter/flutter_export_environment.sh
mobil/ios/Flutter/ephemeral/
mobile/ios/Flutter/app.flx
mobile/ios/Flutter/app.zip
mobile/ios/Flutter/flutter_assets/
mobile/ios/Flutter/App.framework
mobile/ios/**/xcuserdata/
mobile/ios/**/DerivedData/
mobil/ios/**/xcuserdata/
mobil/ios/**/DerivedData/

# ------------------------------------------------------------------------------
# 5. Environment & Sensitive Data
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
